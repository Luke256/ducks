{
  "name": "ducks-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "start": "serve -s dist --no-clipboard --no-port-switching",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "serve": "^14.2.6",
    "vue": "^3.5.0",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "2.4.6",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
}
